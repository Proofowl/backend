# Dependencies
node_modules/

# Build output
dist/
test-build/
*.tsbuildinfo

# Prisma: the generated client is codegen (like the contracts SDK's
# src/generated/) — regenerated by `postinstall` / `prisma generate`.
src/generated/

# Local databases (SQLite). Migrations under prisma/migrations/ ARE
# committed; the .db files they produce are not.
*.db
*.db-journal
prisma/dev.db*

# Environment — only .env.example is committed.
.env
.env.local
.env.*.local

# Editors / OS
.DS_Store
.idea/
.vscode/
*.log
coverage/
