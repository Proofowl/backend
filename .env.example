# proofowl-backend environment. Copy to `.env` and adjust.
# Every value here is a safe default or a CLEARLY FAKE example — never a
# real secret.

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# Local persistence (SQLite via Prisma)
# ---------------------------------------------------------------------------
# Prisma resolves a relative file: URL against the prisma/ directory, so
# this points at prisma/dev.db. Run `npx prisma migrate deploy` once.
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# On-chain reads (Soroban testnet) — READ ONLY in this repo
# ---------------------------------------------------------------------------
# Defaults target the v0.3 (crate 0.3.0) testnet alpha from
# proofowl-contracts' README "Deployed contracts" table.
PROOFOWL_CONTRACT_ID=CAIDTSVPQICTA2VLE6BSQYHEELHGPZWQDYWKSDBRW4LYPZH6Q44UTAOA
PROOFOWL_RPC_URL=https://soroban-testnet.stellar.org
PROOFOWL_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Set to "true" only for a local http:// RPC.
PROOFOWL_ALLOW_HTTP=false

# ---------------------------------------------------------------------------
# GitHub verification
# ---------------------------------------------------------------------------
GITHUB_API_BASE_URL=https://api.github.com
# Optional. A classic/fine-grained PAT with only public read scope just
# raises the unauthenticated rate limit. Leave blank to run unauthenticated.
GITHUB_TOKEN=

# Where the Stellar Wave approved-orgs list is fetched from — tried FIRST
# by the repo_in_approved_orgs check. The canonical page (below) is a
# client-rendered app with no confirmed public JSON endpoint, so today
# this reliably yields "indeterminate" and the manual allowlist below
# takes over. Point this at a real JSON endpoint once one exists and the
# check becomes fully automated.
WAVE_APPROVED_ORGS_URL=https://drips.network/wave/stellar/orgs

# Operator-asserted fallback allowlist, used ONLY when the live source
# above is unavailable. See README "Known limitation: Wave-approval
# verification". A "pass" sourced from here is a MANUAL assertion, marked
# confidence="manually-asserted-allowlist" in the check output — it is
# NOT independently verifiable the way this project's on-chain
# attestations are. Relative paths resolve against the working directory;
# the default file ships with two seed entries.
APPROVED_ORGS_ALLOWLIST_PATH=config/approved-orgs-allowlist.json

# Optional comma-separated exact allow-list of the Wave issue label(s).
# Leave blank to use the built-in case-insensitive matcher ("wave",
# "stellar wave", "wave: ...").
WAVE_LABEL_NAMES=

# ---------------------------------------------------------------------------
# Attestor key — TESTNET attestation submission
# ---------------------------------------------------------------------------
# Read (only) by `createSdkAttestationSubmitter` in
# src/chain/attestationSubmitter.ts when submitting an attestation, and by
# the opt-in submit integration test. It is a Stellar SECRET key (`S...`,
# 56 chars) for the contract's current attestor. It is read straight from
# this environment — it is deliberately NOT surfaced on the shared config
# object (only the boolean `attestorSecretKeyIsSet` is), and it is never
# logged.
#
# The submitter refuses to run against anything but Stellar testnet.
# NEVER put a real key here or in any committed file — the value below is
# a deliberately invalid placeholder; put the real key in `.env` (which is
# git-ignored) only.
ATTESTOR_SECRET_KEY=SEXAMPLE0000000000000000000000000000000000000000000000000FAKE
